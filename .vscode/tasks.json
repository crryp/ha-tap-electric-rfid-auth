{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup / start Home Assistant",
      "type": "shell",
      "command": "./scripts/setup",
      "problemMatcher": []
    },
    {
      "label": "Restart Home Assistant",
      "type": "shell",
      "command": "./scripts/restart",
      "problemMatcher": []
    },
    {
      "label": "Home Assistant logs",
      "type": "shell",
      "command": "./scripts/logs",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "./scripts/test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint (ruff)",
      "type": "shell",
      "command": "./scripts/lint",
      "problemMatcher": []
    }
  ]
}
